{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zy5-tools",
  "compatibility_date": "2026-09-04",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "tools.zy5.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../dist/client",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
